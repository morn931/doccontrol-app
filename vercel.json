{
  "functions": {
    "app/api/intake/webhook/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/import/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/sync-sharepoint/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/sharepoint-sync/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/mddr-sync/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/corebase-contractual/route.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/sharepoint-sync",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/mddr-sync",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/corebase-contractual",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron/redline-nudge",
      "schedule": "0 5 * * 1"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  }
}
